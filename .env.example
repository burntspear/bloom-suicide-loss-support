# ============================================================
# Bloom: environment configuration (copy to .env, never commit .env)
# All values below are PLACEHOLDERS. Nothing here is a real credential.
# ============================================================

NODE_ENV=production
PORT=3000
# Your public https address, no trailing slash. Used for canonical links, sitemap and payment return URLs.
SITE_URL=https://www.your-domain.example
# Number of reverse proxies in front of the app (1 on Render/Fly/Railway/nginx). 0 if none.
TRUST_PROXY=1
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Where the SQLite database lives. Must be on persistent storage and backed up.
DATA_DIR=./data
# Show clearly-labelled sample stories/videos/images. Keep false in production.
SHOW_SAMPLE_CONTENT=false

# ---------------- Admin sign-in ----------------
ADMIN_USERNAME=choose-a-username
# Generate with: npm run hash-password   (paste the whole result, keep the single quotes)
ADMIN_PASSWORD_HASH='scrypt$...'

# ---------------- Payments ----------------
# flutterwave | paystack | none
PAYMENT_PROVIDER=none
# Optional override of the default currency in content/donations.json
DONATION_DEFAULT_CURRENCY=
# Monthly giving. Only set true after recurring payments are enabled on your provider account.
RECURRING_ENABLED=false

# Flutterwave (dashboard > Settings > API Keys / Webhooks)
FLW_SECRET_KEY=FLWSECK_TEST-replace-me
# The "Secret hash" you type into Flutterwave's webhook settings. Choose any long random string and use the same value here.
FLW_WEBHOOK_SECRET_HASH=replace-with-your-chosen-secret-hash

# Paystack (dashboard > Settings > API Keys & Webhooks). Webhooks are signed with this same secret key.
PAYSTACK_SECRET_KEY=sk_test_replace-me

# Hosted checkout needs no public key in the browser. No provider key is ever sent to the front end.

# ---------------- Contact notifications (optional) ----------------
# Messages are always saved and readable in /admin. SMTP only adds an email alert.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bloom <no-reply@your-domain.example>"
CONTACT_NOTIFY_TO=
